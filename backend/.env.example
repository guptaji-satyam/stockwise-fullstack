# StockWise Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your MongoDB Atlas URI or local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stockwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stockwise

# JWT Secret Key for token signing and verification
JWT_SECRET=stockwise_super_secret_jwt_key_2026_dev_mode_change_in_production
JWT_EXPIRE=7d

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
